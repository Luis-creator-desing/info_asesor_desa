<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarjeta de Presentación - Luis Prieto | Accesorios DESA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @media print {
            body {
                background: white;
                display: flex;
                justify-content: center;
                align-items: center;
                min-height: 100vh;
            }
            .no-print {
                display: none !important;
            }
            .print-card {
                box-shadow: none !important;
                border: 1px solid #e5e7eb !important;
                width: 3.5in !important;
                height: 2in !important;
                padding: 1rem !important;
            }
        }
    </style>
</head>
<body class="bg-slate-900 min-h-screen flex flex-col justify-center items-center p-4 text-slate-100 font-sans">

    <!-- Tarjeta Principal -->
    <div class="print-card relative w-full max-w-sm bg-gradient-to-br from-slate-800 to-slate-950 rounded-2xl shadow-2xl border border-slate-700/50 p-6 overflow-hidden">
        
        <!-- Elemento Decorativo de Fondo -->
        <div class="absolute -top-10 -right-10 w-32 h-32 bg-amber-500/10 rounded-full blur-2xl pointer-events-none"></div>
        <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl pointer-events-none"></div>

        <!-- Encabezado / Empresa -->
        <div class="flex justify-between items-start mb-6 border-b border-slate-700/60 pb-4">
            <div>
                <h2 class="text-xl font-extrabold tracking-wider text-amber-500 uppercase">
                    ACCESORIOS <span class="text-white">DESA</span>
                </h2>
                <p class="text-xs text-slate-400 font-medium tracking-wide">Calidad y Servicio Garantizado</p>
            </div>
            <div class="w-10 h-10 rounded-lg bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400">
                <i class="fa-solid fa-gears text-lg"></i>
            </div>
        </div>

        <!-- Datos del Asesor -->
        <div class="mb-6">
            <span class="inline-block px-2.5 py-0.5 text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20 rounded-full mb-1">
                Asesor Comercial
            </span>
            <h1 class="text-2xl font-bold text-white tracking-tight">Luis Prieto</h1>
        </div>

        <!-- Contacto -->
        <div class="space-y-3 mb-6">
            <div class="flex items-center space-x-3 text-slate-300 bg-slate-800/50 p-2.5 rounded-lg border border-slate-700/40">
                <div class="w-8 h-8 rounded-full bg-slate-700 flex items-center justify-center text-amber-400">
                    <i class="fa-solid fa-phone text-sm"></i>
                </div>
                <div>
                    <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Contacto Directo</p>
                    <a href="tel:4641089425" class="text-sm font-semibold hover:text-amber-400 transition-colors">
                        464 108 9425
                    </a>
                </div>
            </div>
        </div>

        <!-- Botones de Acción (Digital) -->
        <div class="no-print grid grid-cols-2 gap-3">
            <a href="tel:4641089425" class="flex items-center justify-center space-x-2 bg-amber-500 hover:bg-amber-600 text-slate-950 font-bold py-2.5 px-4 rounded-xl shadow-lg shadow-amber-500/20 transition-all duration-200 text-sm">
                <i class="fa-solid fa-phone"></i>
                <span>Llamar</span>
            </a>
            <a href="https://wa.me/524641089425" target="_blank" class="flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 px-4 rounded-xl shadow-lg shadow-emerald-600/20 transition-all duration-200 text-sm">
                <i class="fa-brands fa-whatsapp text-lg"></i>
                <span>WhatsApp</span>
            </a>
        </div>
    </div>

    <!-- Acciones Secundarias (no imprimibles) -->
    <div class="no-print mt-6 flex space-x-4">
        <button onclick="window.print()" class="text-xs text-slate-400 hover:text-white flex items-center space-x-1.5 transition-colors">
            <i class="fa-solid fa-print"></i>
            <span>Imprimir Tarjeta</span>
        </button>
    </div>

</body>
</html>